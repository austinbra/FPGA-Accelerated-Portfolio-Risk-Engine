# -------------------------
# 1) Build artifacts
# -------------------------
# If  put all your compiled binaries in a folder like /build or /bin:
build/
__pycache__/
bin/
obj/
*.o
*.obj
*.so
*.dll
*.dylib
*.exe
*.out

# -------------------------
# 2) CMake / Makefile files
# -------------------------
# If  use CMake, ignore its generated files:
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
build/

# if using plain Makefile and generate .a/.so:
*.a
*.so

# -------------------------
# 3) IDE / Editor configs
# -------------------------
# Visual Studio
*.vcxproj*
*.sln
*.suo
# Do not use bare *.user here: it matches a directory named ".user" (* can be empty).
*.vcxproj.user

# VS Code
.vscode/

# CLion / JetBrains
.idea/
*.iml
*.iws

# Xcode
*.xcworkspace
*.xcuserdata
*.xcuserstate

# -------------------------
# 4) OS‐specific files
# -------------------------
# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Icon?
Desktop.ini

# Linux temporary thumbnails
*~

# -------------------------
# 5) Logs / temporary data
# -------------------------
*.log
*.tmp
*.temp

# Any large CSV/JSON/Matlab files you don’t want in Git – e.g. test data:
data/*.csv
data/*.json
logging/

# Vivado project outputs (non-project batch build under repo)
vivado_build/

# Vivado / XSIM generated artifacts
.Xil/
xsim.dir/
*.pb
*.jou
*.wdb
*.str
*.debug
webtalk*.log
vivado*.log
xvlog.log
xelab.log
xsim.log
xvlog.pb
xelab.pb

# Vivado runtime text dumps
dfx_runtime.txt

# Simulation debug traces
*_trace.txt

# Obsidian vault (local knowledge base, not version-controlled)
vault/

# Maintainer-only roadmap (never commit — local backlog / silicon checklist)
.user/ROADMAP_PRIVATE.md

# Optional scratch (never commit secrets or keys)
local/
*.local.md
.env
.env.*
secrets/

# -------------------------
# 6) Cursor / local AI workspace ("memory layer")
# -------------------------
# Rules stay local; only the human index is tracked.
.cursor/*
!.cursor/README.md
.specstory/